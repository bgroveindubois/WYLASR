# WYLAS Bifilar Array Final V17 - TOP exposed row turnarounds
# Top = bifilar coils + exposed cell/row bridges; Bottom = internal cell routing only
# FUNCTIONAL OBJECT NAMES (documentation only; electrical net remains ARRAY)
# Coil 1 = first/red bifilar spiral
# Coil 2 = second/blue bifilar spiral
# Top Bridge = horizontal cell-to-cell bridge on Top
# Bottom Bridge = internal cell routing on Bottom
# Internal pads = C1 Out, C1 In, C2 Out, C2 In, NE Out
# Enter Pad = upper-right array NE Out terminal
# Exit Pad = lower-right array NE Out terminal
# A1 special transform = 90 deg CW, then mirror E/W midpoint
# Row2 = mirror Row1 across south cell edge; pair repeats

GRID MM 0.01 ON;
SET WIRE_BEND 2;
# Auto cell pitch: 25.075000 mm
# Exterior clearance: 1.250000 mm
# Nail effective clearance: 1.425000 mm
# Top bridge copper width: 3.000000 mm
# Top bridge mask opening: 2.600000 mm

LAYER BoardOutline;
LINE 0 (0 0) (203.100000 0) (203.100000 203.100000) (0 203.100000) (0 0);

LAYER Top;
